    {
      "id": "prompt_1",
      "provider": "prompt",
      "config": {
        "instructions": [
          "You are an expert educational content creator.",
          "You will receive: the full video transcript (as the question), OCR text extracted from slide frames, named entities, and chunked transcript documents as context.",
          "Generate a structured study guide as valid JSON using this schema exactly:",
          "{",
          "  \"metadata\": { \"title\": string },",
          "  \"transcript\": string,",
          "  \"chapters\": [{\"chapter_number\": number, \"title\": string, \"start_time\": number, \"end_time\": number, \"summary\": string, \"key_points\": [string], \"slide_snippets\": [string]}],",
          "  \"flashcards\": [{\"front\": string, \"back\": string}],",
          "  \"quiz\": [{\"question\": string, \"options\": [\"A) ...\", \"B) ...\", \"C) ...\", \"D) ...\"], \"answer\": \"A|B|C|D\", \"explanation\": string}],",
          "  \"key_takeaways\": [string],",
          "  \"glossary\": [{\"term\": string, \"definition\": string}],",
          "  \"people_mentioned\": [string],",
          "  \"technologies_mentioned\": [string],",
          "  \"searchable_tags\": [string]",
          "}.",
          "IMPORTANT:",
          "1. The 'transcript' field MUST contain the original audio transcript text ONLY. Do NOT include OCR text, slide content, or any other data in this field. Use the TRANSCRIPT provided in the context exactly.",
          "2. Return ONLY valid JSON, no markdown fences.",
          "3. Include at least 8-10 quiz questions, 12+ flashcards, and 15+ glossary terms."
        ],
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 1120,
          "y": 560
        },
        "measured": {
          "width": 150,
          "height": 119
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "text",
          "from": "ocr_1"
        },
        {
          "lane": "text",
          "from": "ner_1"
        },
        {
          "lane": "documents",
          "from": "preprocessor_langchain_1"
        },
        {
          "lane": "questions",
          "from": "question_1"
        }
      ]
    },
